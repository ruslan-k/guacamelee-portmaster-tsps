+++ b/src/wrapped32/wrappedlibgl.c
@@ -28,6 +28,57 @@ extern const char* libglName;
 
 void* getDisplay(void* d); // define in 32bits wrappedx11.c
 
+typedef void* (*pFu_t)(uint32_t);
+typedef char* (*tFuu_t)(uint32_t, uint32_t);
+
+EXPORT void* my32_glGetString(x64emu_t* emu, uint32_t name)
+{
+    pFu_t fnc = getBridgeFnc2((void*)R_RIP);
+    if(!fnc) fnc = (pFu_t)my->glGetString;
+    const char* src = (const char*)fnc(name);
+    if(!src) return NULL;
+    size_t n = strlen(src) + 1;
+    char* dst = (char*)box32_malloc(n);
+    if(dst) memcpy(dst, src, n);
+    return dst;
+}
+
+EXPORT char* my32_glGetStringi(x64emu_t* emu, uint32_t name, uint32_t index)
+{
+    tFuu_t fnc = getBridgeFnc2((void*)R_RIP);
+    if(!fnc) fnc = (tFuu_t)my->glGetStringi;
+    const char* src = fnc(name, index);
+    if(!src) return NULL;
+    size_t n = strlen(src) + 1;
+    char* dst = (char*)box32_malloc(n);
+    if(dst) memcpy(dst, src, n);
+    return dst;
+}
+
+static void* box32_glx_string(const char* s)
+{
+    size_t n = strlen(s) + 1;
+    char* dst = (char*)box32_malloc(n);
+    if(dst) memcpy(dst, s, n);
+    return dst;
+}
+
+EXPORT void* my32_glXGetClientString(x64emu_t* emu, void* dpy, int name)
+{
+    (void)emu; (void)dpy; (void)name;
+    return box32_glx_string("GL4ES direct KMSDRM");
+}
+EXPORT void* my32_glXQueryExtensionsString(x64emu_t* emu, void* dpy, int screen)
+{
+    (void)emu; (void)dpy; (void)screen;
+    return box32_glx_string("");
+}
+EXPORT void* my32_glXQueryServerString(x64emu_t* emu, void* dpy, int screen, int name)
+{
+    (void)emu; (void)dpy; (void)screen; (void)name;
+    return box32_glx_string("");
+}
