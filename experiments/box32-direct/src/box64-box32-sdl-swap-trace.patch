+#include <time.h>
+
+EXPORT void my32_2_SDL_GL_SwapWindow(x64emu_t* emu, void* window)
+{
+    static unsigned swap_count;
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    unsigned long long ms = (unsigned long long)ts.tv_sec * 1000ULL + (unsigned long long)ts.tv_nsec / 1000000ULL;
+    if (swap_count < 512)
+        fprintf(stderr, "GUA-SWAP t=%llu n=%u\\n", ms, ++swap_count);
+    my->SDL_GL_SwapWindow(window);
+}
